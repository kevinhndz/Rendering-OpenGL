{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar nave OpenGL (Ubuntu)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-I${workspaceFolder}/include",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/glad.c",
        "-o",
        "${workspaceFolder}/nave",
        "-lglfw",
        "-lGL",
        "-ldl",
        "-pthread"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
